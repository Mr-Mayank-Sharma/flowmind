# FlowMind — Environment Template
# =============================================================================
# Copy to `.env` at the repo root and edit. This file is the authoritative
# template for the configuration surface read by apps/api/src/lib/config.ts,
# the Python agent-runtime, and the packages. Variable names below match what
# the code actually reads.
#
# ==> NEVER commit real secrets. Only placeholders belong in git. <==
#
# PostgreSQL port note (5432 vs 5433):
#   The example manifests and compose files bake the standard Postgres port
#   5432. On the local Windows dev box the running Postgres binds 5433. Set
#   DATABASE_URL below to the port YOUR database listens on. This single
#   mismatch is the most common first-run failure.
#
# A minimum working local setup needs: DATABASE_URL, REDIS_URL, JWT_SECRET,
# ENCRYPTION_KEY, AGENT_API_KEY, and OLLAMA_URL (or one cloud LLM key).
# See docs/development/setup.md and docs/deployment/environment.md.
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://flowmind:flowmind@localhost:5432/flowmind"
# NOTE: if your local Postgres is on 5433 (as on the dev box), use:
# DATABASE_URL="postgresql://flowmind:flowmind@localhost:5433/flowmind"

REDIS_URL="redis://localhost:6379"

QDRANT_URL="http://localhost:6333"

# Local LLM endpoint. config.ts reads OLLAMA_URL or OLLAMA_BASE_URL.
OLLAMA_URL="http://localhost:11434"

APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"

NODE_ENV="development"

# ---------------------------------------------------------------------------
# Auth / security (REQUIRED in production)
# ---------------------------------------------------------------------------
# JWT signing secret. Min 32 chars. Production refuses to start without it.
JWT_SECRET="change-me-to-a-min-32-char-string"

# AES-256-GCM master key for credentials at rest (ProviderCredential).
# Must be a 32-byte key. Changing it invalidates stored provider credentials.
ENCRYPTION_KEY="change-me-to-a-min-32-char-aes-key"

# Shared bearer secret between the API and the agent runtime.
# Must be IDENTICAL in this file and in packages/agent-runtime/.env.
AGENT_API_KEY="change-me-to-a-shared-api-key"
# Alias also accepted for the same purpose (internal inter-service secret):
INTERNAL_API_KEY=""

# ---------------------------------------------------------------------------
# LLM providers (at least one required, or a reachable local Ollama)
# ---------------------------------------------------------------------------
# config.ts accepts these canonical names and their shorter aliases
# (e.g. OPENAI_API_KEY or OPENAI_KEY). Set whichever your code reads.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Google/Gemini: config.ts reads GOOGLE_API_KEY | GOOGLE_KEY, while the
# provider-registry surface documents GOOGLE_AI_API_KEY. Set GOOGLE_API_KEY
# for the API config path; the runtime's environment.md references the
# GOOGLE_AI_API_KEY spelling. Keep both consistent if you set either.
GOOGLE_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY=""
TOGETHER_API_KEY=""
MISTRAL_API_KEY=""
PERPLEXITY_API_KEY=""
DEEPINFRA_API_KEY=""
CEREBRAS_API_KEY=""
XAI_API_KEY=""
COHERE_API_KEY=""
CLOUDFLARE_API_KEY=""
VENICE_AI_KEY=""
ALIBABA_API_KEY=""

# Azure OpenAI. docs/deployment/environment.md documents AZURE_OPENAI_ENDPOINT
# (sometimes abbreviated AZURE_ENDPOINT in other templates).
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""

# ---------------------------------------------------------------------------
# Agent runtime (Python, port 8001)
# ---------------------------------------------------------------------------
# Where the API forwards agent calls (config.ts default: http://localhost:8001).
AGENT_RUNTIME_URL="http://localhost:8001"
# Used by the agent runtime itself (must match AGENT_API_KEY above):
OLLAMA_HOST="http://localhost:11434"

# ---------------------------------------------------------------------------
# Billing (Stripe) — REQUIRED for real billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_FREE=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_ENTERPRISE=""
# Dev only: opt in to a local billing mock when STRIPE_SECRET_KEY is unset.
# NEVER set this in production. Only used when STRIPE_SECRET_KEY is absent.
ENABLE_DEV_BILLING_MOCK="false"

# ---------------------------------------------------------------------------
# Channels (Telegram / Slack / Discord / WhatsApp) — feature-gated
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# Webhook verification secrets (per-channel, HMAC-verified)
WEBHOOK_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
SLACK_WEBHOOK_SECRET=""
DISCORD_WEBHOOK_SECRET=""
WHATSAPP_WEBHOOK_SECRET=""
# Dev only: accept webhooks without a secret. Keep false (or unset) in prod.
ALLOW_UNVERIFIED_WEBHOOKS="false"

# ---------------------------------------------------------------------------
# SMTP (transactional email)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@flowmind.ai"

# ---------------------------------------------------------------------------
# OAuth (GitHub / Google / Notion) — for SSO + MCP tools
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Object storage (S3 / MinIO)
# ---------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""

# ---------------------------------------------------------------------------
# Pipeline security switches
# ---------------------------------------------------------------------------
# codeExecute node runs in an isolated-vm sandbox. Disable as a kill switch:
PIPELINE_CODE_EXECUTE_ENABLED="true"
# httpRequest blocks SSRF by default. Keep false in production.
ALLOW_PRIVATE_NETWORK_HTTP="false"
# Deny pipeline write access to the app database. Keep false in production.
PIPELINE_DB_ALLOW_WRITE="false"

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
API_PORT="3001"
API_HOST="0.0.0.0"
LOG_LEVEL="info"
RATE_LIMIT_MAX="200"
RATE_LIMIT_WINDOW="1 minute"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ---------------------------------------------------------------------------
# Admin bootstrap (seed) — only used by `pnpm db:seed`
# ---------------------------------------------------------------------------
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="your-strong-password"
ADMIN_ORG_NAME="My Org"
ADMIN_NAME="Admin"
