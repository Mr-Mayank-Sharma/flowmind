# Required
DATABASE_URL=postgresql://flowmind:flowmind@localhost:5432/flowmind
JWT_SECRET=change-this-to-a-random-secret

# Optional
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
APP_URL=http://localhost:4000
LOG_LEVEL=info
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
AGENT_RUNTIME_URL=http://localhost:8001
AGENT_API_KEY=
INTERNAL_API_KEY=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Pipeline node security (hardening)
# The codeExecute node runs in an isolated VM sandbox (isolated-vm). It is enabled by default;
# set this to "false" to disable codeExecute entirely via an operational kill switch.
PIPELINE_CODE_EXECUTE_ENABLED=true
# httpRequest blocks SSRF (private/loopback/link-local ranges) by default. Only set to "true"
# if you explicitly need to allow requests to private/cloud-local networks (not recommended).
ALLOW_PRIVATE_NETWORK_HTTP=false

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
# Dev-only: when STRIPE_SECRET_KEY is unset, explicitly opt in to the local billing mock (never active in production)
ENABLE_DEV_BILLING_MOCK=false

# Webhooks (optional)
WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=
SLACK_WEBHOOK_SECRET=
DISCORD_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
# Dev-only: accept webhooks without a secret in production (not recommended)
ALLOW_UNVERIFIED_WEBHOOKS=false

# SSO (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@flowmind.ai
